#!/bin/sh
PIDFILE="/var/run/adguardhome.pid"
BIN="/opt/AdGuardHome/AdGuardHome"
CONF="/opt/AdGuardHome/AdGuardHome.yaml"
WORKDIR="/opt/AdGuardHome/data"
LOGFILE="/var/log/adguardhome.log"

is_running() {
    [ -f "$PIDFILE" ] || return 1
    PID=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$PID" ] || return 1
    if kill -0 "$PID" 2>/dev/null && grep -qa "AdGuardHome" "/proc/$PID/cmdline" 2>/dev/null; then
        return 0
    fi
    rm -f "$PIDFILE"
    return 1
}

case "$1" in
    start)
        if is_running; then
            echo "AdGuard Home is already running (PID $(cat "$PIDFILE"))"
            exit 0
        fi
        echo "Starting AdGuard Home..."
        mkdir -p "$WORKDIR" /var/log
        nohup "$BIN" -c "$CONF" -w "$WORKDIR" --pidfile "$PIDFILE" -l "$LOGFILE" >/dev/null 2>&1 &
        sleep 1
        if is_running; then
            echo "AdGuard Home started successfully (PID $(cat "$PIDFILE"))"
        else
            echo "Failed to start AdGuard Home. Check $LOGFILE"
            exit 1
        fi
        ;;
    stop)
        if is_running; then
            PID=$(cat "$PIDFILE")
            echo "Stopping AdGuard Home (PID $PID)..."
            kill "$PID" 2>/dev/null || true
            rm -f "$PIDFILE"
            echo "AdGuard Home stopped."
        else
            echo "AdGuard Home is not running."
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if is_running; then
            echo "AdGuard Home is running (PID $(cat "$PIDFILE"))"
        else
            echo "AdGuard Home is stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
