#!/bin/sh
# HDMI Terminal Daemon for ZTE B760H
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export HOME=/home/darrel
export USER=darrel
export TERM=linux
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
cd /home/darrel

# Start USB Keyboard bridge if not already running
if ! pgrep -f hdmi-kbd-bridge >/dev/null; then
    /usr/local/bin/hdmi-kbd-bridge </dev/null >/dev/null 2>&1 &
fi

while [ ! -c /dev/graphics/fb0 ]; do
    sleep 1
done

while true; do
    if ! tmux -u has-session -t hdmi 2>/dev/null; then
        tmux -u new-session -d -s hdmi -n console /usr/bin/fish
    fi
    /usr/local/bin/fbpad tmux -u attach -t hdmi < /dev/null
    sleep 1
done
